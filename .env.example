# Everything here can also be changed from the web panel.

# Sign-in method: "oauth" (Connect with Claude in the panel) or "session" (claude.ai sessionKey)
LED_AUTH_MODE=oauth

# Session mode only. Never commit real values.
CLAUDE_SESSION_KEY=
CLAUDE_CF_CLEARANCE=
LED_USER_AGENT=
CLAUDE_ORG_ID=

# Bluetooth address of the LED matrix (set from the panel with "Find displays")
LED_ADDRESS=

# Display
LED_BRIGHTNESS=60
LED_ORIENTATION=0
LED_ALTERNATE=30
LED_REFRESH=60
LED_RESET_ANIM=1
LED_INCREASE_ANIM=1
# Empty = the device's timezone, e.g. Europe/Paris
LED_TZ=

# Web panel
LED_WEB_PORT=8080
# Optional code required to change the account or the display
LED_ADMIN_TOKEN=
